<?xml version="1.0" encoding="UTF-8"?>
<!--
Wrapper schema providing a global root element for the DC terms
instance documents. The dcterms schema (dc_terms.xml) only provides
a container complexType, no root element declaration.
Validates against: http://purl.org/dc/terms/ (dc_terms.xml, which
imports dc.xsd and dcmitype.xsd from this directory).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:dcterms="http://purl.org/dc/terms/"
           elementFormDefault="qualified">
    <xs:import namespace="http://purl.org/dc/terms/" schemaLocation="dc_terms.xml"/>
    <xs:element name="dublinCoreCore" type="dcterms:elementOrRefinementContainer"/>
</xs:schema>
